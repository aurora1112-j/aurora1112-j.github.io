---
import { Icon } from "astro-icon/components";
import Layout from "../layouts/Layout.astro";
import PageWrapper from "../components/layouts/PageWrapper.astro";
import LocalizedText from "../components/i18n/LocalizedText.astro";
import BotanicalSymbol from "../components/icons/BotanicalSymbol.astro";
import { SITE } from "../data/site";

const proofPoints = [
	{ value: "54,870", zh: "条 Query 用于需求归类", en: "queries analysed for product discovery" },
	{ value: "6 / 15", zh: "类 CUA 场景 / Showcase Cases", en: "CUA scenario groups / showcase cases" },
	{ value: "300+ / 100+", zh: "社群成员 / 调研反馈", en: "community members / research responses" },
	{ value: "13 / 8", zh: "公开 PR / 已合并 PR", en: "public PRs / merged PRs" },
];

const focusAreas = [
	{ symbol: "branch", zh: "Agent 平台", en: "Agent platforms", descZh: "工作流、工具调用、上下文与长期记忆。", descEn: "Workflows, tool use, context, and long-term memory." },
	{ symbol: "graft", zh: "人机协作", en: "Human–AI collaboration", descZh: "渐进式自主、敏感动作接管与异常恢复。", descEn: "Progressive autonomy, human takeover, and recovery." },
	{ symbol: "rings", zh: "数据与评估", en: "Data & evaluation", descZh: "需求归类、分析契约、Gold Case 与 Bad Case。", descEn: "Demand analysis, contracts, gold cases, and bad cases." },
	{ symbol: "roots", zh: "技术验证", en: "Technical validation", descZh: "对齐 PRD、原型、代码与真实运行结果。", descEn: "Aligning specs, prototypes, code, and runtime evidence." },
] as const;

const personSchema = {
	"@context": "https://schema.org",
	"@type": "Person",
	name: SITE.name,
	alternateName: "黄晨熙",
	url: `${SITE.siteUrl}${SITE.portfolioPath}`,
	email: `mailto:${SITE.email}`,
	jobTitle: "AI Product Manager Candidate",
	affiliation: { "@type": "CollegeOrUniversity", name: "Nanjing University" },
	sameAs: [SITE.githubUrl, SITE.xUrl],
	knowsAbout: ["AI agents", "Human-AI collaboration", "RAG", "Agent evaluation", "Data products", "Product design"],
};
---

<Layout
	title="黄晨熙｜2027 AI 产品经理求职档案"
	titleEn="Chenxi Huang | 2027 AI Product Manager Portfolio"
	desc="黄晨熙的 AI 产品经理求职档案：Agent 平台、AI Tooling、数据与评估、人机协作。"
	descEn="Chenxi Huang's AI product portfolio across agent platforms, AI tooling, data and evaluation, and human–AI collaboration."
>
	<script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
	<PageWrapper class="hire-page">
		<header class="hire-hero">
			<div class="hero-copy">
				<p class="eyebrow">2027 · AI PRODUCT MANAGER</p>
				<h1><LocalizedText zh="让 Agent 能做事，也让人始终看得懂、接得住。" en="I design agents that can act while people stay informed and in control." /></h1>
				<p class="lede"><LocalizedText zh="南京大学本科生，曾在字节跳动扣子与阶跃星辰从事 AI 产品工作。我的主线是把模型与 Agent 能力转化为可验证的产品链路：从场景定义、原型和数据分析，到接管、异常恢复与运行验收。" en="I study at Nanjing University and have worked on AI products at ByteDance Coze and StepFun. I turn model and agent capabilities into testable product flows—from problem framing and prototypes to data analysis, takeover, recovery, and runtime validation." /></p>
				<nav class="hero-actions" aria-label="Portfolio actions">
					<a class="primary" href={SITE.publicResumePath} target="_blank"><LocalizedText zh="下载公开简历" en="Download public resume" /><Icon name="heroicons:arrow-down-tray" size={18} /></a>
					<a href="/vesti"><LocalizedText zh="查看 Vesti 案例" en="View Vesti case" /></a>
					<a href={SITE.githubUrl} target="_blank" rel="me noreferrer">GitHub</a>
					<a href="/contact"><LocalizedText zh="联系我" en="Contact" /></a>
				</nav>
			</div>
			<div class="hero-mark" aria-hidden="true"><BotanicalSymbol name="graft" size={190} /></div>
		</header>

		<section class="proof" aria-labelledby="proof-title">
			<div class="section-heading">
				<p class="eyebrow"><LocalizedText zh="可核验的工作" en="VERIFIABLE WORK" /></p>
				<h2 id="proof-title"><LocalizedText zh="把经历压缩成可以追问的证据。" en="Evidence designed to withstand follow-up questions." /></h2>
			</div>
			<div class="proof-grid">
				{proofPoints.map((point) => (
					<article>
						<strong>{point.value}</strong>
						<p><LocalizedText zh={point.zh} en={point.en} /></p>
					</article>
				))}
			</div>
		</section>

		<section class="focus" aria-labelledby="focus-title">
			<div class="section-heading compact">
				<p class="eyebrow"><LocalizedText zh="能力方向" en="FOCUS" /></p>
				<h2 id="focus-title"><LocalizedText zh="我适合解决的问题" en="The problems I am prepared to own" /></h2>
			</div>
			<div class="focus-grid">
				{focusAreas.map((area) => (
					<article>
						<BotanicalSymbol name={area.symbol} size={44} />
						<h3><LocalizedText zh={area.zh} en={area.en} /></h3>
						<p><LocalizedText zh={area.descZh} en={area.descEn} /></p>
					</article>
				))}
			</div>
		</section>

		<section class="experience" aria-labelledby="experience-title">
			<div class="section-heading compact">
				<p class="eyebrow"><LocalizedText zh="经历摘要" en="EXPERIENCE" /></p>
				<h2 id="experience-title"><LocalizedText zh="从内部复杂系统到公开产品" en="From internal systems to public products" /></h2>
			</div>
			<div class="experience-list">
				<article>
					<div class="experience-meta"><span>2026.06—</span><strong><LocalizedText zh="字节跳动 · 扣子" en="ByteDance · Coze" /></strong></div>
					<h3><LocalizedText zh="Browser Use、数据分析 Plugin 与 Computer Use Agent" en="Browser Use, data-analysis plugins, and Computer Use Agents" /></h3>
					<p><LocalizedText zh="负责三端 Browser Use 产品方案与原型；基于 54,870 条 Query 定义 Agent-native 数据分析产品；用 6 类、15 个 Showcase Case 跟进 CUA 跨端验收。这里仅展示可公开的方法与范围，不公开内部截图和未发布细节。" en="I designed cross-platform Browser Use flows, used 54,870 queries to define an agent-native data product, and organised six CUA scenario groups with 15 showcase cases for cross-platform validation. Only public-safe methods and scope are shown here." /></p>
				</article>
				<article>
					<div class="experience-meta"><span>2026.03—06</span><strong><LocalizedText zh="阶跃星辰 · 开发者生态" en="StepFun · Developer ecosystem" /></strong></div>
					<h3><LocalizedText zh="AI Studio 与 Deep Research Agent" en="AI Studio and Deep Research Agents" /></h3>
					<p><LocalizedText zh="定义 AI 应用开发平台的 Showcase、Playground 与参数调试模块，并用首次结果成功率、二次操作率和有用反馈率组织指标；将 Deep Research 的检索过程重构为计划、证据、检查点和下一步行动。" en="I defined Showcase, Playground, and parameter-tuning modules for an AI application platform, organised metrics around first-result success, second actions, and useful feedback, and reframed deep-research execution as plans, evidence, checkpoints, and next actions." /></p>
				</article>
				<article>
					<div class="experience-meta"><span>2026.01—</span><strong>Vesti</strong></div>
					<h3><LocalizedText zh="本地优先的 AI 对话记忆层" en="A local-first memory layer for AI conversations" /></h3>
					<p><LocalizedText zh="联合创始人，主导产品与交互设计，并实现核心前端与数据链路。公开贡献包括 13 个 PR、其中 8 个已合并，覆盖 Library、标注导出、时间网络和 Markdown 笔记工作区。" en="As a co-founder, I led product and interaction design and implemented core frontend and data flows. Public evidence includes 13 PRs, eight merged, across Library, annotation export, temporal networks, and the Markdown note workspace." /></p>
					<a class="text-link" href="/vesti"><LocalizedText zh="阅读完整案例" en="Read the full case" /> →</a>
				</article>
			</div>
		</section>

		<section class="verification" aria-labelledby="verification-title">
			<div>
				<p class="eyebrow"><LocalizedText zh="证据边界" en="EVIDENCE BOUNDARY" /></p>
				<h2 id="verification-title"><LocalizedText zh="不把计划写成结果，也不把 Mock 写成线上评测。" en="Plans are not outcomes, and mock gates are not live model evaluation." /></h2>
			</div>
			<p><LocalizedText zh="本页数字均来自现有简历或公开 GitHub 记录。Vesti 当前公开 Eval 只证明结构化输出契约可以回归测试；由于 live workflow 缺少模型密钥并实际跳过，本页不展示模型成功率、延迟或成本指标。" en="Every number on this page comes from the current resume or public GitHub records. Vesti's public eval currently demonstrates contract regression only. Its live workflow is skipped without model credentials, so no model success, latency, or cost metric is presented here." /></p>
		</section>
	</PageWrapper>
</Layout>

<style>
	:global(.hire-page) { max-width: 1480px; margin-top: var(--space-s); }
	.hire-hero { min-height: 68vh; display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(180px, .5fr); align-items: center; gap: var(--space-xl); padding: var(--space-xl) 0; border-bottom: 1px solid var(--color-tinted-cream); }
	.hero-copy { max-width: 980px; }
	.eyebrow { margin: 0; color: var(--color-accent-text); font-family: var(--font-sans); font-size: var(--font-size-xs); letter-spacing: .14em; text-transform: uppercase; }
	h1 { max-width: 1050px; margin: var(--space-xs) 0 var(--space-s); font-family: var(--font-serif); font-size: clamp(2.7rem, 5.5vw, 5.9rem); font-weight: 300; line-height: .94; letter-spacing: -.04em; }
	.lede { max-width: 820px; margin: 0; color: var(--color-gray-600); font-size: var(--font-size-md); line-height: var(--leading-loose); }
	.hero-actions { display: flex; flex-wrap: wrap; gap: var(--space-xs) var(--space-s); margin-top: var(--space-m); font-family: var(--font-sans); font-size: var(--font-size-sm); }
	.hero-actions a { display: inline-flex; align-items: center; gap: .4rem; padding: .55rem 0; border-bottom: 1px solid var(--color-gray-300); }
	.hero-actions a:hover, .hero-actions .primary { color: var(--color-crimson); border-color: currentColor; }
	.hero-mark { justify-self: center; color: var(--color-sea-blue); opacity: .78; transform: rotate(8deg); }
	section { margin: var(--space-2xl) 0; }
	.section-heading { display: grid; grid-template-columns: minmax(150px, .35fr) minmax(0, 1.65fr); gap: var(--space-l); align-items: start; margin-bottom: var(--space-l); }
	.section-heading.compact { margin-bottom: var(--space-m); }
	h2 { max-width: 960px; margin: 0; font-family: var(--font-serif); font-size: clamp(2rem, 4.7vw, 4.8rem); font-weight: 300; line-height: 1; letter-spacing: -.03em; }
	.proof-grid, .focus-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--space-m); }
	.proof-grid article, .focus-grid article { padding: var(--space-s) 0; border-top: 1px solid var(--color-sea-blue); }
	.proof-grid strong { display: block; font-family: var(--font-serif); font-size: clamp(2.2rem, 4vw, 4.5rem); font-weight: 300; color: var(--color-gray-800); }
	.proof-grid p, .focus-grid p { color: var(--color-gray-600); line-height: var(--leading-loose); }
	.focus-grid article :global(svg) { color: var(--color-sea-blue); margin-bottom: var(--space-xs); }
	.focus-grid h3 { margin: 0; font-family: var(--font-serif); font-size: var(--font-size-lg); font-weight: 400; }
	.experience-list { margin-left: calc(35% + var(--space-l)); }
	.experience-list article { display: grid; grid-template-columns: minmax(180px, .45fr) minmax(0, 1.55fr); gap: var(--space-m); padding: var(--space-l) 0; border-top: 1px solid var(--color-gray-300); }
	.experience-meta { display: grid; align-content: start; gap: .35rem; color: var(--color-gray-500); font-family: var(--font-sans); font-size: var(--font-size-xs); }
	.experience-meta strong { color: var(--color-gray-800); font-size: var(--font-size-sm); }
	.experience-list h3 { margin: 0 0 var(--space-xs); font-family: var(--font-serif); font-size: var(--font-size-xl); font-weight: 400; }
	.experience-list p { margin: 0; color: var(--color-gray-600); line-height: var(--leading-loose); }
	.text-link { display: inline-block; margin-top: var(--space-xs); color: var(--color-crimson); font-family: var(--font-sans); font-size: var(--font-size-sm); }
	.verification { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(280px, .9fr); gap: var(--space-xl); padding: var(--space-l); border: 1px solid var(--color-tinted-cream); background: var(--color-light-cream); }
	.verification h2 { margin-top: var(--space-xs); font-size: clamp(1.8rem, 3.5vw, 3.5rem); }
	.verification > p { margin: 0; align-self: end; color: var(--color-gray-600); line-height: var(--leading-loose); }
	@media (max-width: 850px) {
		.hire-hero { min-height: auto; grid-template-columns: 1fr; }
		.hero-mark { display: none; }
		.section-heading, .verification { grid-template-columns: 1fr; gap: var(--space-s); }
		.proof-grid, .focus-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
		.experience-list { margin-left: 0; }
		.experience-list article { grid-template-columns: 1fr; gap: var(--space-s); }
	}
	@media (max-width: 520px) {
		.proof-grid, .focus-grid { grid-template-columns: 1fr; }
		.verification { padding: var(--space-m); }
	}
</style>
