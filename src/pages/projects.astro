---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import PageWrapper from "../components/layouts/PageWrapper.astro";
import ProjectCard from "../components/cards/ProjectCard.astro";
import LocalizedText from "../components/i18n/LocalizedText.astro";
import { extractBaseSlug } from "../utils/versionUtils";

const projects = (await getCollection("projects", ({ data }) => !data.draft)).sort(
	(a, b) => b.data.updated.getTime() - a.data.updated.getTime(),
);
---

<Layout title="作品｜Chenxi Huang" titleEn="Works | Chenxi Huang">
	<PageWrapper class="works-page">
		<header class="collection-header">
			<p class="eyebrow"><LocalizedText zh="产品 · 设计系统 · 开源 · 实验" en="Products · Design systems · Open source · Experiments" /></p>
			<h1><LocalizedText zh="作品与项目" en="Works & Projects" /></h1>
			<p><LocalizedText zh="把概念带进真实问题的产品、原型与开源工具。这里记录的不只是一张结果图，也包括判断、约束和仍待解决的问题。" en="Products, prototypes, and open tools that bring concepts into real problems—along with the decisions, constraints, and unresolved questions behind them." /></p>
		</header>
		<section class="project-field" aria-label="Projects">
			{projects.map((project) => (
				<div class="project-entry">
					<ProjectCard slug={extractBaseSlug(project.id)} cover={project.data.cover} title={project.data.title} titleEn={project.data.titleEn} description={project.data.description} descriptionEn={project.data.descriptionEn} projectKind={project.data.projectKind} roleZh={project.data.roleZh} roleEn={project.data.roleEn} />
				</div>
			))}
		</section>
	</PageWrapper>
</Layout>

<style>
	:global(main.works-page) { margin-top: var(--space-s); margin-bottom: var(--space-2xl); }
	.collection-header { max-width: 760px; padding: var(--space-m) 0 var(--space-xl); }
	.eyebrow { color: var(--color-sea-blue); font-family: var(--font-sans); font-size: var(--font-size-xs); letter-spacing: .12em; text-transform: uppercase; }
	h1 { margin: var(--space-2xs) 0 var(--space-xs); font-family: var(--font-serif); font-size: clamp(2.8rem, 6vw, 5.8rem); font-weight: 300; }
	.collection-header > p:last-child { max-width: 650px; color: var(--color-gray-600); line-height: var(--leading-loose); }
	.project-field { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: clamp(2rem, 4vw, 4rem) var(--space-m); margin-bottom: var(--space-2xl); align-items: start; }
	.project-entry:nth-child(3n + 1) { grid-column: 1 / span 5; }
	.project-entry:nth-child(3n + 2) { grid-column: 7 / span 5; margin-top: clamp(1.5rem, 3.5vw, 3.25rem); }
	.project-entry:nth-child(3n + 3) { grid-column: 3 / span 4; margin-top: calc(var(--space-s) * -.7); }
	@media (max-width: 760px) { .project-field { grid-template-columns: 1fr; } .project-entry:nth-child(n) { grid-column: 1; margin-top: 0; } }
</style>
