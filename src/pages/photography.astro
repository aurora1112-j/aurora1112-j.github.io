---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import PageWrapper from "../components/layouts/PageWrapper.astro";
import PhotoAlbumCard from "../components/cards/PhotoAlbumCard.astro";
import LocalizedText from "../components/i18n/LocalizedText.astro";
import { extractBaseSlug } from "../utils/versionUtils";

const albums = (await getCollection("photography", ({ data }) => !data.draft)).sort(
	(a, b) => b.data.updated.getTime() - a.data.updated.getTime(),
);
---

<Layout title="摄影｜Chenxi Huang" titleEn="Photography | Chenxi Huang">
	<PageWrapper>
		<header class="collection-header">
			<p class="eyebrow"><LocalizedText zh="视觉观察" en="Visual observations" /></p>
			<h1><LocalizedText zh="摄影集" en="Photography" /></h1>
			<p><LocalizedText zh="按系列保存光线、城市、植物和偶然出现的结构。摄影在这里不是装饰，而是另一种观察与记忆的方法。" en="Series about light, cities, plants, and accidental structures. Photography here is not decoration, but another method of observation and memory." /></p>
		</header>
		<section class="photo-field" aria-label="Photo albums">
			{albums.map((album) => (
				<div class="photo-entry">
					<PhotoAlbumCard slug={extractBaseSlug(album.id)} cover={album.data.cover} title={album.data.title} titleEn={album.data.titleEn} description={album.data.description} descriptionEn={album.data.descriptionEn} locationZh={album.data.locationZh} locationEn={album.data.locationEn} imageCount={album.data.imageCount} />
				</div>
			))}
		</section>
	</PageWrapper>
</Layout>

<style>
	.collection-header { max-width: 760px; padding: var(--space-xl) 0 var(--space-2xl); }
	.eyebrow { color: var(--color-sea-blue); font-family: var(--font-sans); font-size: var(--font-size-xs); letter-spacing: .12em; text-transform: uppercase; }
	h1 { margin: var(--space-2xs) 0 var(--space-xs); font-family: var(--font-serif); font-size: clamp(2.8rem, 6vw, 5.8rem); font-weight: 300; }
	.collection-header > p:last-child { max-width: 650px; color: var(--color-gray-600); line-height: var(--leading-loose); }
	.photo-field { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: var(--space-2xl) var(--space-l); margin-bottom: var(--space-3xl); align-items: start; }
	.photo-entry:nth-child(odd) { grid-column: 1 / span 7; }
	.photo-entry:nth-child(even) { grid-column: 8 / span 4; margin-top: var(--space-2xl); }
	@media (max-width: 760px) { .photo-field { grid-template-columns: 1fr; } .photo-entry:nth-child(n) { grid-column: 1; margin-top: 0; } }
</style>
