---
import Layout from "../layouts/Layout.astro";
import Title2 from "../components/mdx/typography/Title2.astro";
import PageWrapper from "../components/layouts/PageWrapper.astro";
import BookCard from "../components/cards/BookCard.astro";
import TitleWithCount from "../components/layouts/TitleWithCount.astro";
import { getCollection } from "astro:content";
import LocalizedText from "../components/i18n/LocalizedText.astro";

const antiBookData = await getCollection("antibooks");
---

<Layout title="Chenxi Huang 的待读书架" titleEn="Chenxi Huang's Antilibrary">
	<PageWrapper>
		<header style="margin-bottom: var(--space-2xl);">
			<TitleWithCount posts={antiBookData}>
				<a href="/library" class="styled-link"><LocalizedText zh="书架" en="Library" /></a>
				<div style="color: var(--color-gray-300); display: inline-block">|</div>
				<LocalizedText zh="待读" en="Antilibrary" />
			</TitleWithCount>
			<Title2><LocalizedText zh="我还没有读，但希望未来能进入知识系统的书。" en="Books I have not read yet but hope will enter this knowledge system." /></Title2>
		</header>
		<section class="bookshelf-grid">
			{
				antiBookData.map((book) => (
					<BookCard
						subtitle={book.data.subtitle}
						subtitleEn={book.data.subtitleEn}
						link={book.data.link}
						title={book.data.title}
						titleEn={book.data.titleEn}
						author={book.data.author}
						authorEn={book.data.authorEn}
						cover={book.data.cover}
					/>
				))
			}
		</section>
	</PageWrapper>
</Layout>

<style>
	.styled-link {
		color: var(--color-gray-300);
		transition: all 0.4s ease-in-out;
		cursor: pointer;
	}
	.styled-link:hover {
		color: var(--color-bright-crimson);
	}

	.bookshelf-grid {
		display: grid;
		grid-gap: var(--space-s);
		grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
	}
</style>
