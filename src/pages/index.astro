---
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import Layout from "../layouts/Layout.astro";
import PageWrapper from "../components/layouts/PageWrapper.astro";
import LocalizedText from "../components/i18n/LocalizedText.astro";
import HomeGrowthTrail from "../components/garden/HomeGrowthTrail.astro";
import ConceptCard from "../components/cards/ConceptCard.astro";
import ProjectCard from "../components/cards/ProjectCard.astro";
import PhotoAlbumCard from "../components/cards/PhotoAlbumCard.astro";
import EssayCard from "../components/cards/EssayCard.astro";
import { SITE } from "../data/site";
import { extractBaseSlug } from "../utils/versionUtils";

const concepts = (await getCollection("concepts", ({ data }) => !data.draft)).sort(
	(a, b) => b.data.updated.getTime() - a.data.updated.getTime(),
);
const featuredEssays = (await getCollection("essays", ({ data }) => !data.draft && data.featured === true)).sort(
	(a, b) => b.data.updated.getTime() - a.data.updated.getTime(),
);
const projects = (await getCollection("projects", ({ data }) => !data.draft)).sort(
	(a, b) => b.data.updated.getTime() - a.data.updated.getTime(),
);
const homeProjectSlugs = ["vesti", "vesti-design-system"];
const featuredProjects = projects
	.filter((project) => homeProjectSlugs.includes(extractBaseSlug(project.id)))
	.sort((a, b) => homeProjectSlugs.indexOf(extractBaseSlug(a.id)) - homeProjectSlugs.indexOf(extractBaseSlug(b.id)));
const photography = (await getCollection("photography", ({ data }) => !data.draft)).sort(
	(a, b) => b.data.updated.getTime() - a.data.updated.getTime(),
);
---

<Layout
	title="Chenxi Huang｜AI 产品经理与设计师"
	titleEn="Chenxi Huang | AI PM & Designer"
	desc="Chenxi Huang 的个人知识花园，关于 AI、Agent、产品设计、开源实践与视觉观察。"
	descEn="Chenxi Huang's personal knowledge garden for AI, agents, product design, open work, and visual observation."
>
	<PageWrapper class="home-page">
		<header class="hero">
			<div class="portrait-wrap">
				<img src={SITE.avatar} alt="Chenxi Huang" class="portrait" width="460" height="460" />
				<span class="orbit" aria-hidden="true"></span>
			</div>
			<div class="hero-copy">
				<p class="kicker">CHENXI HUANG · <LocalizedText zh={SITE.roleZh} en={SITE.roleEn} /></p>
				<h1><LocalizedText zh="我理解复杂概念，也把它们做成可以使用的系统。" en="I understand difficult ideas and turn them into systems people can use." /></h1>
				<p class="intro"><LocalizedText zh="我在南京大学学习，持续探索 AI、Agent、产品与知识管理。这里同时保存概念解释、项目、开源实践和摄影观察，也保留它们尚未完成的生长过程。" en="I study at Nanjing University and explore AI, agents, products, and knowledge systems. This space holds concept explanations, projects, open work, and photographic observations—including their unfinished growth." /></p>
				<nav class="hero-links" aria-label="Primary calls to action">
					<a href="/projects"><LocalizedText zh="查看作品" en="View works" /><Icon name="heroicons:arrow-right" size={18} /></a>
					<a href="/garden"><LocalizedText zh="进入花园" en="Enter the Garden" /></a>
					<a href="/about"><LocalizedText zh="认识我" en="About me" /></a>
				</nav>
			</div>
		</header>
		<HomeGrowthTrail />

		<section class="recent" aria-labelledby="recent-title">
			<div class="section-heading">
				<div>
					<p class="kicker"><LocalizedText zh="核心作品" en="SELECTED WORK" /></p>
					<h2 id="recent-title"><LocalizedText zh="把记忆做成产品与视觉系统" en="Turning memory into product and visual systems" /></h2>
				</div>
				<a href="/projects"><LocalizedText zh="查看全部作品" en="View all works" /> →</a>
			</div>
			<div class="recent-grid">
				{featuredProjects.map((project) => (
					<div class="feature-entry">
						<ProjectCard slug={extractBaseSlug(project.id)} cover={project.data.cover} title={project.data.title} titleEn={project.data.titleEn} description={project.data.description} descriptionEn={project.data.descriptionEn} projectKind={project.data.projectKind} roleZh={project.data.roleZh} roleEn={project.data.roleEn} />
					</div>
				))}
				<div class="photo-entry">
					<PhotoAlbumCard slug={extractBaseSlug(photography[0].id)} cover={photography[0].data.cover} title={photography[0].data.title} titleEn={photography[0].data.titleEn} description={photography[0].data.description} descriptionEn={photography[0].data.descriptionEn} locationZh={photography[0].data.locationZh} locationEn={photography[0].data.locationEn} imageCount={photography[0].data.imageCount} />
				</div>
			</div>
		</section>

		{featuredEssays[0] && (
			<section class="featured-essay" aria-labelledby="featured-essay-title">
				<div class="section-heading">
					<div>
						<p class="kicker"><LocalizedText zh="精选文章" en="FEATURED ESSAY" /></p>
						<h2 id="featured-essay-title"><LocalizedText zh="最近的长篇思考" en="A recent long-form argument" /></h2>
					</div>
					<a href="/essays"><LocalizedText zh="查看全部文章" en="View all essays" /> →</a>
				</div>
				<div class="featured-essay-card">
					<EssayCard
						id={featuredEssays[0].id}
						slug={extractBaseSlug(featuredEssays[0].id)}
						cover={featuredEssays[0].data.cover}
						title={featuredEssays[0].data.title}
						titleEn={featuredEssays[0].data.titleEn}
						description={featuredEssays[0].data.description}
						descriptionEn={featuredEssays[0].data.descriptionEn}
						growthStage={featuredEssays[0].data.growthStage}
						date={featuredEssays[0].data.updated}
					/>
				</div>
			</section>
		)}

		<section class="ideas" aria-labelledby="ideas-title">
			<div class="section-heading">
				<div>
					<p class="kicker"><LocalizedText zh="正在生长" en="GROWING IDEAS" /></p>
					<h2 id="ideas-title"><LocalizedText zh="最近反复思考的三个问题" en="Three questions I keep returning to" /></h2>
				</div>
				<a href="/concepts"><LocalizedText zh="进入概念库" en="Explore concepts" /> →</a>
			</div>
			<div class="concept-grid">
				{concepts.slice(0, 3).map((concept) => (
					<div class="concept-entry">
						<ConceptCard slug={extractBaseSlug(concept.id)} title={concept.data.title} titleEn={concept.data.titleEn} description={concept.data.description} descriptionEn={concept.data.descriptionEn} growthStage={concept.data.growthStage} topics={concept.data.topics} />
					</div>
				))}
			</div>
		</section>
	</PageWrapper>
</Layout>

<style>
	:global(.home-page) { margin-top: var(--space-xs); margin-bottom: var(--space-xl); }
	.hero { display: grid; grid-template-columns: minmax(150px, .42fr) minmax(0, 1.58fr); align-items: center; gap: clamp(1.5rem, 4vw, 4rem); padding: var(--space-m) 0 var(--space-l); }
	.portrait-wrap { position: relative; justify-self: end; width: min(18vw, 180px); }
	.portrait { display: block; width: 100%; aspect-ratio: 1; object-fit: cover; filter: saturate(.76) contrast(.96); border-radius: 48% 38% 52% 42%; box-shadow: 0 24px 60px rgba(31, 55, 41, .16); transform: rotate(-2deg); }
	.orbit { position: absolute; inset: -9% -11% -7% -8%; border: 1px solid var(--color-sea-blue); opacity: .42; border-radius: 50% 44% 47% 43%; transform: rotate(9deg); }
	.kicker { font-family: var(--font-sans); font-size: var(--font-size-xs); letter-spacing: .12em; color: var(--color-accent-text); text-transform: uppercase; }
	h1 { max-width: 720px; margin: var(--space-xs) 0 var(--space-s); font-family: var(--font-serif); font-size: clamp(2.2rem, 4.5vw, 4.7rem); line-height: .98; font-weight: 300; letter-spacing: -.035em; }
	.intro { max-width: 690px; color: var(--color-gray-600); font-size: var(--font-size-md); line-height: var(--leading-loose); }
	.hero-links { display: flex; flex-wrap: wrap; gap: var(--space-s); margin-top: var(--space-m); font-family: var(--font-sans); }
	.hero-links a { display: inline-flex; align-items: center; gap: .35rem; padding-bottom: .2rem; border-bottom: 1px solid var(--color-gray-300); transition: .25s ease; }
	.hero-links a:first-child { color: var(--color-crimson); border-color: currentColor; }
	.hero-links a:hover { color: var(--color-sea-blue); transform: translateY(-2px); }
	.recent { margin: var(--space-s) 0 var(--space-l); }
	.featured-essay { margin: var(--space-xl) 0 var(--space-l); }
	.featured-essay-card { width: min(100%, 540px); }
	.section-heading { display: flex; justify-content: space-between; align-items: end; gap: var(--space-s); margin-bottom: var(--space-m); }
	.section-heading h2 { margin: .35rem 0 0; font-family: var(--font-serif); font-size: clamp(1.8rem, 4vw, 3.2rem); font-weight: 300; }
	.section-heading > a { font-family: var(--font-sans); font-size: var(--font-size-sm); color: var(--color-crimson); white-space: nowrap; }
	.recent-grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: var(--space-m); align-items: start; }
	.feature-entry:first-child { grid-column: 1 / span 5; width: 100%; transform: rotate(-.35deg); }
	.feature-entry:nth-child(2) { grid-column: 6 / span 3; margin-top: var(--space-l); transform: rotate(.4deg); }
	.photo-entry { grid-column: 9 / span 4; width: 100%; margin-top: calc(var(--space-s) * -.35); transform: rotate(-.25deg); }
	.ideas { margin: var(--space-xl) 0 var(--space-l); }
	.concept-grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: var(--space-m); align-items: start; }
	.concept-entry { grid-column: span 4; }
	.concept-entry:nth-child(2) { margin-top: var(--space-s); }
	.concept-entry:nth-child(3) { margin-top: calc(var(--space-xs) * -.5); }
	@media (max-width: 720px) {
		.hero { min-height: auto; grid-template-columns: 1fr; gap: var(--space-l); padding-top: var(--space-l); }
		.portrait-wrap { justify-self: start; width: min(58vw, 250px); order: 2; margin-left: 12%; }
		.hero-copy { order: 1; }
		.recent-grid, .concept-grid { grid-template-columns: 1fr; }
		.feature-entry, .concept-entry, .photo-entry { grid-column: 1; grid-row: auto; width: 100%; margin: 0; transform: none; }
		.section-heading { align-items: start; flex-direction: column; }
	}
</style>
