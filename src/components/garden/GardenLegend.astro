---
import BotanicalSymbol from "../icons/BotanicalSymbol.astro";
import LocalizedText from "../i18n/LocalizedText.astro";

const items = [
	{ icon: "roots", zh: "根", en: "Roots" },
	{ icon: "bud", zh: "芽", en: "Buds" },
	{ icon: "branch", zh: "枝", en: "Branches" },
	{ icon: "rings", zh: "年轮", en: "Rings" },
	{ icon: "graft", zh: "嫁接", en: "Grafts" },
	{ icon: "canopy", zh: "树冠", en: "Canopy" },
] as const;
---

<aside class="garden-legend" aria-label="Botanical Systems legend">
	<div class="legend-head">
		<div class="legend-intro">
			<span class="line" aria-hidden="true"></span>
			<p><LocalizedText zh="如何阅读这座花园" en="How to read this garden" /></p>
		</div>
	</div>
	<div class="legend-items">
		{items.map((item, index) => (
			<div class="legend-item" style={`--legend-index:${index}`}>
				<BotanicalSymbol name={item.icon} size={34} />
				<span><LocalizedText zh={item.zh} en={item.en} /></span>
			</div>
		))}
	</div>
	<a class="legend-link" href="/about#botanical-systems">
		<LocalizedText zh="了解完整理念" en="Read the full philosophy" />
		<span aria-hidden="true">↗</span>
	</a>
</aside>

<style>
	.garden-legend {
		position: relative;
		margin: calc(var(--space-xl) * -0.2) 0 var(--space-xl);
		padding: var(--space-s) 0 var(--space-m);
		font-family: var(--font-sans);
	}
	.legend-head { display: flex; align-items: center; justify-content: space-between; gap: var(--space-m); margin-bottom: var(--space-m); }
	.legend-intro { display: flex; align-items: center; gap: var(--space-xs); min-width: 0; }
	.legend-intro p { margin: 0; color: var(--color-gray-500); font-size: var(--font-size-xs); letter-spacing: .08em; text-transform: uppercase; }
	.line { width: clamp(30px, 8vw, 110px); height: 1px; background: var(--color-sea-blue); opacity: .6; }
	.legend-items { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); align-items: center; gap: var(--space-s); padding-inline: clamp(0px, 3vw, 48px); }
	.legend-item { display: flex; justify-content: center; align-items: center; gap: .55rem; min-width: 0; color: var(--color-sea-blue); transform: translateY(calc((var(--legend-index) % 3) * 3px)); }
	.legend-item span { color: var(--color-gray-600); font-size: var(--font-size-xs); white-space: nowrap; }
	.legend-link { display: flex; align-items: center; justify-content: flex-end; gap: .35rem; width: fit-content; margin: var(--space-m) 0 0 auto; color: var(--color-crimson); font-size: var(--font-size-xs); white-space: nowrap; }
	.legend-link span { font-size: var(--font-size-sm); }
	@media (max-width: 960px) {
		.legend-items { grid-template-columns: repeat(3, minmax(0, 1fr)); row-gap: var(--space-m); }
	}
	@media (max-width: 640px) {
		.legend-items { grid-template-columns: 1fr 1fr; padding-inline: 0; gap: var(--space-s); }
		.legend-item { justify-content: flex-start; }
	}
</style>
