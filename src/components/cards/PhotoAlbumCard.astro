---
import { Image } from "astro:assets";
import LocalizedText from "../i18n/LocalizedText.astro";

const { slug, cover, title, titleEn, description, descriptionEn, locationZh, locationEn, imageCount } = Astro.props;
---

<a class="photo-card" href={`/${slug}`}>
	<figure>
		<Image src={cover} alt={title} width={900} height={700} loading="lazy" />
		<figcaption>
			<div>
				<p class="type"><LocalizedText zh="摄影系列" en="Photo series" />{imageCount ? ` · ${imageCount}` : ""}</p>
				<h3><LocalizedText zh={title} en={titleEn || title} /></h3>
			</div>
			{locationZh && <span><LocalizedText zh={locationZh} en={locationEn || locationZh} /></span>}
		</figcaption>
	</figure>
	<p class="description"><LocalizedText zh={description} en={descriptionEn || description} /></p>
</a>

<style>
	.photo-card { display: block; color: var(--color-gray-800); }
	figure { margin: 0; }
	figure :global(img) { width: 100%; max-height: 70vh; object-fit: cover; filter: saturate(.72) contrast(.96); transition: filter .45s ease, transform .45s ease; }
	figcaption { display: flex; justify-content: space-between; align-items: end; gap: var(--space-s); padding-top: var(--space-xs); }
	.type { margin: 0 0 .25rem; color: var(--color-gray-500); font-family: var(--font-sans); font-size: var(--font-size-xs); letter-spacing: .08em; text-transform: uppercase; }
	h3 { margin: 0; font-family: var(--font-serif); font-size: var(--font-size-md); font-weight: 400; }
	figcaption > span { color: var(--color-gray-500); font-family: var(--font-sans); font-size: var(--font-size-xs); white-space: nowrap; }
	.description { max-width: 34rem; margin: var(--space-2xs) 0 0; color: var(--color-gray-600); font-size: var(--font-size-sm); line-height: var(--leading-loose); }
	.photo-card:hover figure :global(img) { filter: saturate(.95) contrast(1); transform: scale(1.008); }
	.photo-card:hover h3 { color: var(--color-crimson); }
</style>
