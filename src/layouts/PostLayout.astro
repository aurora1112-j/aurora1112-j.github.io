---
import type { CollectionEntry } from "astro:content";
import type { MarkdownHeading } from "astro";
import Layout from "./Layout.astro";
import { Icon } from "astro-icon/components";
import Backlinks from "../components/layouts/Backlinks.astro";
import WebMentions from "../components/layouts/WebMentions.astro";
import linkMaps from "../links.json";
import GrowthIcon from "../components/layouts/GrowthIcon.astro";
import GrowthStage from "../components/layouts/GrowthStage.astro";
import Dates from "../components/layouts/Dates.astro";
import Topics from "../components/layouts/Topics.astro";
import VersionWarning from "../components/layouts/VersionWarning.astro";
import VersionDropdown from "../components/layouts/VersionDropdown.astro";
import { getCanonicalUrlFromEntry, getCanonicalDates } from "../utils/versionUtils";
import { getCollection } from "astro:content";
import LocalizedText from "../components/i18n/LocalizedText.astro";

type Props = {
	frontmatter:
		| CollectionEntry<"concepts">["data"]
		| CollectionEntry<"projects">["data"]
		| CollectionEntry<"photography">["data"]
		| CollectionEntry<"essays">["data"]
		| CollectionEntry<"notes">["data"]
		| CollectionEntry<"patterns">["data"]
		| CollectionEntry<"talks">["data"];
	headings: MarkdownHeading[];
	entry?:
		| CollectionEntry<"concepts">
		| CollectionEntry<"projects">
		| CollectionEntry<"photography">
		| CollectionEntry<"essays">
		| CollectionEntry<"notes">
		| CollectionEntry<"patterns">
		| CollectionEntry<"talks">;
};

const { frontmatter, entry } = Astro.props;

// Get the current page's slug from the URL
const currentSlug = Astro.url.pathname.replace(/^\/|\/$/g, "");

// Calculate canonical URL for versioned content
const canonicalURL = entry
	? new URL(getCanonicalUrlFromEntry(entry), Astro.site!).toString()
	: undefined;

// Get canonical dates for versioned content (consistent across all versions)
let canonicalDates: { startDate: Date; updated?: Date } = {
	startDate: frontmatter.startDate,
	updated: frontmatter.updated,
};
if (entry) {
	// Fetch all entries from the same collection to resolve canonical dates across versions
	const allEntries = (await getCollection(entry.collection)) as (typeof entry)[];
	const versionedDates = getCanonicalDates(entry, allEntries);
	canonicalDates = {
		startDate: new Date(versionedDates.startDate),
		updated: versionedDates.updated ? new Date(versionedDates.updated) : undefined,
	};
}

// Capitalise the content type for the back-link label (e.g. "essay" → "Essay")
const contentTypeLabels = {
	concept: { zh: "概念", en: "Concepts", href: "/concepts" },
	project: { zh: "作品", en: "Works", href: "/projects" },
	photography: { zh: "摄影", en: "Photography", href: "/photography" },
	essay: { zh: "文章", en: "Essays", href: "/essays" },
	note: { zh: "笔记", en: "Notes", href: "/notes" },
	pattern: { zh: "模式", en: "Patterns", href: "/patterns" },
	talk: { zh: "分享", en: "Talks", href: "/talks" },
};
const contentTypeLabel = contentTypeLabels[frontmatter.type];

// Find the current post in linkMaps
const currentPost = linkMaps.find((post) => post.slug === currentSlug);

// Get backlinks for the current post
const backlinks = currentPost?.inboundLinks || [];

// For concepts: fetch related/connected concepts
const relatedConcepts: Array<{
  slug: string;
  title: string;
  titleEn: string;
  description: string;
  descriptionEn: string;
  growthStage: string;
  relationship: string;
  labelZh: string;
  labelEn: string;
}> = [];
if (frontmatter.type === "concept" && "connections" in frontmatter && Array.isArray((frontmatter as any).connections)) {
  const allConcepts = await getCollection("concepts");
  for (const conn of (frontmatter as any).connections) {
    const target = allConcepts.find((c) => c.id === conn.slug || c.id.endsWith(`/${conn.slug}`) || c.id.endsWith(`/${conn.slug}.mdx`));
    if (target && !target.data.draft) {
      relatedConcepts.push({
        slug: conn.slug,
        title: target.data.title,
        titleEn: target.data.titleEn,
        description: target.data.description,
        descriptionEn: target.data.descriptionEn,
        growthStage: target.data.growthStage,
        relationship: conn.relationship,
        labelZh: conn.labelZh,
        labelEn: conn.labelEn,
      });
    }
  }
}

// Only essays and talks have cover images
const coverImage =
	frontmatter.type === "essay" || frontmatter.type === "talk" || frontmatter.type === "project" || frontmatter.type === "photography"
		? frontmatter.cover?.src
		: undefined;

const startDateISO =
	canonicalDates.startDate instanceof Date
		? canonicalDates.startDate.toISOString()
		: canonicalDates.startDate;
const updatedISO =
	canonicalDates.updated instanceof Date
		? canonicalDates.updated.toISOString()
		: (canonicalDates.updated ?? "");
---

<Layout
	title={frontmatter.title}
	titleEn={frontmatter.titleEn}
	desc={frontmatter.description}
	descEn={frontmatter.descriptionEn}
	type={frontmatter.type}
	coverImage={coverImage}
	canonicalURL={canonicalURL}
>
	<header class="header-section">
		<div class="above-title">
			<div class="back-link">
				<a href={contentTypeLabel.href}>
					<Icon name="heroicons:arrow-left" size={16} />
					<LocalizedText as="span" zh={contentTypeLabel.zh} en={contentTypeLabel.en} />
				</a>
			</div>
			<GrowthIcon
				size="16"
				growthStage={frontmatter.growthStage as "budding" | "evergreen" | "seedling"}
			/>
			<GrowthStage stage={frontmatter.growthStage as "budding" | "evergreen" | "seedling"} />
			{frontmatter.draft && <span class="draft-label"><LocalizedText zh="草稿" en="Draft" /></span>}
		</div>
		<div class="title-container">
			<h1><LocalizedText zh={frontmatter.title} en={frontmatter.titleEn} /></h1>
			{frontmatter.description && <p><LocalizedText zh={frontmatter.description} en={frontmatter.descriptionEn || frontmatter.description} /></p>}
		</div>
		<div class="metadata">
			<div class="metadata-left">
				{frontmatter.topics && <Topics topics={frontmatter.topics} />}
			</div>
			<div class="metadata-right">
				<Dates
					startDate={startDateISO}
					updated={updatedISO}
				/>
				{entry && <VersionDropdown entry={entry} />}
			</div>
		</div>
		{entry && <VersionWarning entry={entry} />}
	</header>


	<article class="styled-main">
		<slot />
	</article>

	{backlinks.length ? <Backlinks backlinks={backlinks} /> : null}

		{
			relatedConcepts.length > 0 ? (
				<section class="related-concepts" aria-label="Related concepts">
					<h2 class="related-heading">
						<LocalizedText zh="关联概念" en="Related Concepts" />
					</h2>
					<div class="related-grid">
						{relatedConcepts.map((rc) => (
							<a href={`/${rc.slug}`} class="related-card">
								<span class="related-rel" data-copy-zh={rc.labelZh} data-copy-en={rc.labelEn}>
									{rc.relationship}
								</span>
								<h3><LocalizedText zh={rc.title} en={rc.titleEn} /></h3>
								<p><LocalizedText zh={rc.description} en={rc.descriptionEn} /></p>
								<span class="related-stage">
									<GrowthIcon size="12" growthStage={rc.growthStage as "budding" | "evergreen" | "seedling"} />
									<GrowthStage stage={rc.growthStage as "budding" | "evergreen" | "seedling"} />
								</span>
							</a>
						))}
					</div>
				</section>
			) : null
		}

	<WebMentions postSlug={currentSlug} hasBacklinks={backlinks.length > 0} />
</Layout>

<style>
	.title-container {
		padding: var(--space-s) 0 var(--space-l);
		border-bottom: 1px solid var(--color-tinted-cream);
	}

	.title-container h1 {
		font-size: var(--font-size-2xl);
		font-weight: 600;
		line-height: var(--leading-tighter);
		max-width: 100%;
	}

	.title-container p {
		font-size: var(--font-size-md);
		margin: var(--space-s) 0 0 0;
		color: var(--color-gray-600);
		line-height: var(--leading-base);
	}

	.header-section {
		max-width: 800px;
		margin: var(--space-l) auto 0;
	}

	.above-title {
		display: flex;
		align-items: center;
		gap: var(--space-xs);
		min-height: 24px;
	}

	.above-title a,
	.above-title p {
		display: inline-flex;
		align-items: center;
		font-family: var(--font-sans);
		font-size: var(--font-size-xs);
		text-transform: uppercase;
		letter-spacing: 0.05em;
		font-weight: bold;
		margin: 0;
	}

	.above-title svg {
		display: block;
		position: relative;
		margin: auto 0;
	}

	.metadata {
		justify-content: space-between;
		display: flex;
		flex-direction: row;
		align-items: flex-start;
		gap: var(--space-s);
	}

	.metadata-left {
		flex: 1;
	}

	.metadata-right {
		flex-shrink: 0;
		text-align: right;
		display: flex;
		flex-direction: column;
		align-items: flex-end;
	}

	.styled-main {
		margin-top: var(--space-xs);
		padding: var(--space-l) 0 var(--space-2xl);
		background: linear-gradient(var(--color-cream) 0, var(--color-white) 110px);
		width: 100%;
	}

	@media (max-width: 864px) {
		.styled-main,
		.header-section {
			padding-inline: var(--space-xs);
		}
	}

	@media (max-width: 768px) {
		.metadata {
			flex-direction: column;
			text-align: left;
			align-items: flex-start;
			gap: var(--space-xs);
		}

		.metadata-right {
			width: 100%;
			text-align: left;
			align-items: flex-start;
			flex-direction: row;
			justify-content: space-between;
		}

		.styled-main {
			padding: var(--space-xl) var(--space-xs);
		}

		.header-section {
			padding: 0 var(--space-xs);
		}
	}

	@media screen and (max-width: 425px) {
		.title-container h1 {
			font-size: var(--font-size-xl);
		}

		.title-container p {
			font-size: var(--font-size-base);
		}
	}

	.draft-label {
		display: inline-block;
		font-family: var(--font-sans);
		font-size: var(--font-size-xs);
		text-transform: uppercase;
		letter-spacing: 0.05em;
		font-weight: bold;
		padding: 2px 6px;
		border-radius: 4px;
		background-color: var(--color-gray-200);
		color: var(--color-gray-700);
		margin-left: var(--space-xs);
	}

	.back-link {
		display: flex;
		align-items: center;
		height: 100%;
	}

	.back-link a {
		display: inline-flex;
		align-items: center;
		position: relative;
		font-family: var(--font-sans);
		font-size: var(--font-size-xs);
		text-transform: uppercase;
		letter-spacing: 0.05em;
		font-weight: bold;
		transition: all 0.8s cubic-bezier(0.2, 1, 0.8, 1);
		margin: 0;
		padding: 0;
	}

	.back-link svg {
		width: 0;
		transition: all 0.8s cubic-bezier(0.2, 1, 0.8, 1);
		color: var(--color-gray-300);
		position: relative;
		top: 1px;
	}

	.back-link span {
		display: inline-block;
		transition: transform 0.3s cubic-bezier(0.2, 1, 0.8, 1);
		color: var(--color-bright-crimson);
	}

	.back-link a:hover svg {
		width: 16px;
		margin-right: 2px;
		color: var(--color-sea-blue);
	}

	.back-link a:hover span {
		transform: translate3d(3px, 0, 0);
	}

	.related-concepts {
		max-width: 800px;
		margin: var(--space-xl) auto 0;
		padding: var(--space-l) 0;
		border-top: 1px solid var(--color-gray-200);
	}

	.related-heading {
		font-family: var(--font-sans);
		font-size: var(--font-size-xs);
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-gray-500);
		margin: 0 0 var(--space-m);
	}

	.related-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
		gap: var(--space-m);
	}

	.related-card {
		display: block;
		padding: var(--space-m);
		border: 1px solid var(--color-gray-200);
		border-radius: var(--border-radius-base);
		background: var(--color-cream);
		transition: transform 0.25s ease, border-color 0.25s ease;
	}

	.related-card:hover {
		transform: translateY(-3px);
		border-color: var(--color-sea-blue-40);
	}

	.related-rel {
		display: inline-block;
		font-family: var(--font-sans);
		font-size: 10px;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--color-sea-blue);
		background: var(--color-sea-blue-10, color-mix(in srgb, var(--color-sea-blue) 10%, transparent));
		padding: 1px 8px;
		border-radius: 10px;
		margin-bottom: var(--space-2xs);
	}

	.related-card h3 {
		margin: var(--space-2xs) 0;
		font-family: var(--font-serif);
		font-size: var(--font-size-base);
		font-weight: 400;
		color: var(--color-gray-800);
	}

	.related-card p {
		margin: 0;
		font-size: var(--font-size-sm);
		color: var(--color-gray-600);
		line-height: var(--leading-snug);
	}

	.related-stage {
		display: flex;
		align-items: center;
		gap: 4px;
		margin-top: var(--space-xs);
	}

	@media (max-width: 768px) {
		.related-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
